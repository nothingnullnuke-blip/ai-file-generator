# Environment
ENVIRONMENT=development

# OpenRouter API (Primary - 100+ models)
# Get key: https://openrouter.ai/keys
OR_API_KEY=your_openrouter_api_key_here
OR_MODEL=mistralai/mistral-7b-instruct

# HuggingFace API (Fallback)
# Get key: https://huggingface.co/settings/tokens
HF_API_KEY=your_huggingface_api_key_here
HF_MODEL=mistralai/Mistral-7B-Instruct-v0.2

# AI Parameters
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2048
AI_TIMEOUT=30

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Caching
CACHE_TTL_HOURS=24
CACHE_MAX_SIZE=100

# File Generation
MAX_FILE_SIZE_MB=100
MAX_PROMPT_LENGTH=5000
MIN_PROMPT_LENGTH=10

# Logging
LOG_LEVEL=INFO